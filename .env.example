# Allow-Exec — copy these NAMES into Vercel → Settings → Environment Variables.
# Never commit real values. Never paste the trading key in the UI.

# Trading wallet secret (base58 64-byte key, or JSON byte array). Server-side only.
BOT_PRIVATE_KEY=

# Must be "true" for real txs. Leave unset or false for paper / dry-run.
BOT_LIVE_ENABLED=false

# Helius RPC (recommended). Wins over any RPC URL typed in the desk.
HELIUS_API_KEY=

# Optional fallback RPC if Helius is not set.
# SOLANA_RPC_URL=

# Phantom / Solflare public keys allowed to use the desk (comma or space separated).
OPERATOR_WHITELIST=

# Optional HMAC secret for operator sessions. Falls back to the bot key if unset.
# BOT_OPERATOR_SECRET=
